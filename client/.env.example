# Google OAuth "Web application" client ID
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Finnhub API key (https://finnhub.io). This runs entirely in the browser, so
# the key WILL be visible in the bundle. Use a free personal key and treat
# anyone with your Pages URL as able to use it against your 60 req/min quota.
VITE_FINNHUB_API_KEY=your_finnhub_key_here
